{
  "name": "finance-tracker",
  "version": "0.1.1",
  "private": true,
  "description": "Local personal finance organizer with manual entry and file import",
  "license": "GPL-3.0-only",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run rebuild:electron && electron-vite dev",
    "dev:demo": "npm run rebuild:electron && FT_DB_PATH=.dev-data/demo.sqlite FT_SEED=demo electron-vite dev",
    "dev:demo:reset": "rm -f .dev-data/demo.sqlite*",
    "build": "electron-vite build",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run rebuild:node && vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "package": "npm run rebuild:electron && npm run build && electron-builder --publish never",
    "package:dir": "npm run rebuild:electron && npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "better-sqlite3": "^12.0.0",
    "csv-parse": "^7.0.3",
    "lucide-react": "^1.72.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.0",
    "@eslint/js": "^9.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.0",
    "eslint": "^9.0.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "author": "Richard Schuster",
  "homepage": "https://github.com/ricschuster/finance-tracker"
}
